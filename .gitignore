# ============================================
#  敏感信息 —— 绝对不能提交
# ============================================
# API Key 不写入任何文件。用户安装脚本后，
# 在页面悬浮面板的「API 与参数设置」里自行填写，
# 保存在浏览器本地（Tampermonkey / ScriptCat 的 GM 存储）。
.env
.env.*
!.env.example
*.local.js
config.local.js

# ============================================
#  脚本管理器本地运行产物（含个人标识，勿公开）
# ============================================
scriptcat-backup*.zip
*.storage.json
*.options.json
scriptcat-config.json
ZhiHuiShu-WenDa-Autoscript/_orig/

# ============================================
#  调试与临时产物
# ============================================
# 调试用 CDP 脚本（_ 前缀），用完即删，不提交
_*.js
# 沙箱 ACL 修复工具留下的备份/报告
.acl-recovery/

# ============================================
#  系统 / 编辑器
# ============================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log

# ============================================
#  依赖（通常本项目不需要）
# ============================================
node_modules/
package-lock.json
pnpm-lock.yaml
